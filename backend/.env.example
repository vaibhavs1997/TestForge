# Backend Configuration
PORT=3000
NODE_ENV=production
# Parent directory of this path is the JSON data root (not SQLite)
DB_PATH=/app/data/testforge.db
CORS_ORIGIN=http://localhost:80
LOG_LEVEL=info

# Optional API authentication (enable one or both for production)
# TESTFORGE_API_KEY=change-me
# TESTFORGE_JWT_SECRET=change-me-jwt-signing-secret
