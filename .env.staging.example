# TestForge single-node staging environment
# Copy to .env.staging, replace every placeholder with a real value, and keep
# the result outside source control. Generate random values using your approved
# secret manager; the values below are deliberately invalid examples.

# Public origin served by the frontend reverse proxy.
CORS_ORIGIN=https://staging.testforge.example
TESTFORGE_AUTH_ENABLED=true

# At least one normal authentication mechanism is required. JWT is the usual
# option for staging. Use a high-entropy secret (32+ bytes); never use this text.
TESTFORGE_JWT_SECRET=REPLACE_WITH_A_HIGH_ENTROPY_JWT_SECRET
# TESTFORGE_API_KEY=REPLACE_WITH_A_HIGH_ENTROPY_API_KEY

# Required: base64 encoding of exactly 32 random bytes. This key encrypts the
# persistent local SecretStore and must be retained for restore/rollback.
TESTFORGE_SECRET_STORE_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# Operational settings
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
METRICS_INTERNAL_ONLY=true
MAX_BACKUPS=10

# Keep optional external services disabled until explicitly provisioned.
AI_ENABLED=false
RAG_ENABLED=false
EMBEDDING_ENABLED=false
