# TestForge local-development environment
# Copy to .env. This file contains examples only; never commit real credentials.

PORT=3000
NODE_ENV=development
TESTFORGE_AUTH_ENABLED=false
DB_PATH=./data/testforge.db
PERSISTENCE_DRIVER=json
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Local development may generate a key in backend/data/runtime. To use the
# staging-compatible secret-store mode, set a base64-encoded 32-byte key here.
# TESTFORGE_SECRET_STORE_KEY=replace-with-base64-32-byte-key

# Optional API/JWT authentication for local testing.
# TESTFORGE_API_KEY=replace-with-a-long-random-value
# TESTFORGE_JWT_SECRET=replace-with-a-long-random-value

# JSON repositories are single-node only. Production/staging require this to
# be true explicitly; local development does not.
# TESTFORGE_ALLOW_SINGLE_NODE_JSON=true

# Optional RAG/embedding support. Application persistence remains file based.
RAG_ENABLED=false
EMBEDDING_ENABLED=false
# RAG_DATABASE_URL=postgresql://username:password@postgres:5432/testforge
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=your-embedding-model
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional AI generation capability; credentials are managed server-side.
AI_ENABLED=false
# AI_DEFAULT_PROVIDER=provider-id
# AI_DEFAULT_MODEL=model-id
# AI_EXTERNAL_GOVERNANCE_MODE=REDACT

# Optional integrations (server-side only).
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=replace-with-a-token
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=replace-me
# SMTP_PASS=replace-me
