# Backend Configuration
PORT=3000
NODE_ENV=development
# Parent directory of this path is the JSON data root (SQLite reserved for future use)
DB_PATH=./data/testforge.db
PERSISTENCE_DRIVER=json
CORS_ORIGIN=*
LOG_LEVEL=info

# Enterprise SaaS login (MongoDB) — when set, login/register are required and projects are tenant-scoped
# MONGODB_URI=mongodb+srv://user:pass@cluster.example.net/UssrAuthentication
# MONGODB_USERS_COLLECTION=userAuthentication
# TESTFORGE_JWT_SECRET=use-a-long-random-secret-min-32-chars

# Welcome email after registration (optional — if SMTP_HOST is unset, account still works; no email sent)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-mailtrap-user
# SMTP_PASS=your-mailtrap-password
# SMTP_SECURE=false
# MAIL_FROM=TestForge <noreply@yourdomain.com>
# APP_NAME=TestForge

# Optional API authentication (enable one or both for production)
# TESTFORGE_API_KEY=change-me
# TESTFORGE_JWT_SECRET=change-me-jwt-signing-secret
# JWT payload example: { "sub": "user-id", "projects": ["GPR_01"] } or "projects": "*"
# Projects created via API while authenticated are tagged with ownerId=sub and remain accessible even if not listed in the token yet.
