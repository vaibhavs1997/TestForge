# Frontend Configuration
# Dev: use /api so Vite proxies to http://localhost:3000 (see vite.config.ts)
VITE_API_URL=/api
# Production / direct backend: VITE_API_URL=http://localhost:3000/api
# Optional: must match backend TESTFORGE_API_KEY when API auth is enabled (admin / full access)
# VITE_API_KEY=change-me
# Per-user access: store a JWT from your IdP (sub + projects claim). Overrides API key when set.
# VITE_AUTH_JWT=eyJ...
# Dev-only: stable browser profile id when no JWT (local multi-tab isolation for recent projects UI)
# VITE_DEV_USER_ID=alice
