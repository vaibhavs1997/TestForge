# TestForge — single environment file (repository root)
# Copy to `.env` and adjust. Backend and frontend both read from here.
#
# Backend is started from `backend/` — paths like DB_PATH are relative to that folder.

# ─── Backend ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
TESTFORGE_AUTH_ENABLED=false
DB_PATH=./data/testforge.db
PERSISTENCE_DRIVER=json
CORS_ORIGIN=*
LOG_LEVEL=info
# Set false only for local Docker development; production keeps rate limiting enabled.
# RATE_LIMIT_ENABLED=false

# Local PostgreSQL + pgvector development container
# Start with: docker compose -f docker-compose.local.yml up -d
# This container is intentionally separate from the current JSON/SQLite
# application persistence until a PostgreSQL repository driver is configured.
# POSTGRES_PORT=5432
# POSTGRES_DB=testforge
# POSTGRES_USER=testforge
# POSTGRES_PASSWORD=replace-with-a-local-development-password
# Optional RAG/vector subsystem. Existing application persistence remains DB_PATH.
RAG_ENABLED=false
# RAG_DATABASE_URL=postgresql://username:password@postgres:5432/testforge
# RAG_DB_CONNECTION_TIMEOUT_MS=5000
# RAG_DB_POOL_MAX=5
# RAG_DB_SSL=false
# Embeddings are separate from chat/reasoning providers and remain opt-in.
EMBEDDING_ENABLED=false
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=your-embedding-model
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
# EMBEDDING_TIMEOUT_MS=30000
# EMBEDDING_BATCH_SIZE=32
# Provider-neutral reasoning/generation capability configuration (credentials stay infrastructure-only).
AI_ENABLED=false
# AI_DEFAULT_PROVIDER=provider-id
# AI_DEFAULT_MODEL=model-id
# AI_FALLBACK_PROVIDER=provider-id
# AI_FALLBACK_MODEL=model-id
# AI_TIMEOUT_MS=30000
# AI_RETRY_LIMIT=0
# AI_DEFAULT_TEMPERATURE=0.2
# AI_EXTERNAL_GOVERNANCE_MODE=REDACT

# Enterprise login (MongoDB)
# MONGODB_URI=mongodb+srv://user:pass@cluster.example.net/UssrAuthentication
# MONGODB_USERS_COLLECTION=userAuthentication
# TESTFORGE_JWT_SECRET=use-a-long-random-secret-min-32-chars

# Local Ollama (auto-registers AI provider per project)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_MS=300000

# SMTP (welcome email)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM=TestForge <noreply@yourdomain.com>
# APP_NAME=TestForge

# Optional API auth
# TESTFORGE_API_KEY=change-me

# Jira (server-side only — import requirements & post test reports)
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=your-api-token
# Optional link in Jira comments: TESTFORGE_PUBLIC_URL=http://localhost:5173

# ─── Frontend (Vite — only VITE_* are exposed to the browser) ───────────────
# Dev: /api is proxied to PORT above (see frontend/vite.config.ts)
VITE_API_URL=/api
# VITE_API_KEY=change-me
# VITE_AUTH_JWT=eyJ...
# VITE_DEV_USER_ID=alice
